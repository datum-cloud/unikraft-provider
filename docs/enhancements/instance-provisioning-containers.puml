@startuml instance-provisioning-containers
!$NEW_C4_STYLE = 1
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
!include https://raw.githubusercontent.com/datum-cloud/enhancements/main/enhancements/datum-theme.puml

LAYOUT_TOP_DOWN()

title Container diagram — Datum Cloud compute (Workload to running unikernel)

Person(user, "Platform Consumer", "Declares Workloads: an instance template plus placements (city codes + scale)")

System_Boundary(datum, "Datum Cloud") {

    System_Boundary(project_cp, "Project Control Plane") {
        Container(project_api, "Project API Server", "Kubernetes API", "Stores Workload, WorkloadDeployment, Network; event bus for project controllers")
        Container(wlc, "Workload Controller", "Go / controller-runtime", "Expands a Workload into one WorkloadDeployment per placement and city code")
        Container(fed, "WorkloadDeployment Federator", "Go / controller-runtime", "Pushes WorkloadDeployments and per-city-code PropagationPolicies downstream; mirrors aggregated status back")
    }

    System_Ext(karmada, "Karmada", "Federation control plane; propagates each WorkloadDeployment to the edge clusters matching its PropagationPolicy")

    System_Boundary(edge, "Edge Location (POP-cell cluster, one per city code)") {
        Container(edge_api, "Edge API Server", "Kubernetes API", "Stores Instance, Pod, VPCAttachment, NetworkAttachmentDefinition; event bus for edge operators")
        Container(wdc, "WorkloadDeployment Controller", "Go / controller-runtime", "Materializes the Instance replicas for its location")
        Container(co, "Compute Operator", "Go / controller-runtime", "Resolves instance network interfaces, drives IP allocation, manages VPCAttachments")
        Container(up, "Unikraft Provider", "Go / controller-runtime", "Translates each Instance into a Pod bound for a Kraftlet node; syncs Pod status back onto the Instance")
        Container(go_op, "Galactic Operator", "Go / controller-runtime + webhook", "Builds the CNI chain definition (NetworkAttachmentDefinition) per VPCAttachment; injects the Multus annotation into Pods")
        Container(platform, "Platform Services", "Network Services · IPAM · Quota", "Allocate private IPs from subnet address pools, enforce quota")

        Boundary(host, "Unikraft Host (per node)") {
            Container(kraftlet, "Kraftlet", "Host agent", "Registers as a node; turns scheduled Pods into unikernel configs, drives the CNI chain, boots unikernels, reports status")
            Container(gnet, "Galactic Networking", "CNI chain + BGP", "Multus → IPAM CNI → Galactic CNI: provisions VRF/TAP/veth plumbing, programs SRv6 routes, announces endpoints over BGP")
            Container(uk, "Unikernel Instance", "Unikraft VM", "The consumer's workload, attached to its VPC via a TAP device")
        }
    }
}

System_Ext(registry, "OCI Registry", "Hosts unikernel images")
System_Ext(fabric, "Datum Network Fabric", "BGP peers / SRv6 backbone interconnecting VPCs across locations")

' Spine: project control plane → federation → edge cluster → host
Rel_D(user, project_api, "Declares Workload", "HTTPS")
Rel_R(wlc, project_api, "Workload → WorkloadDeployments", "reconcile")
Rel_L(project_api, fed, "WorkloadDeployment events", "watch")
Rel_D(fed, karmada, "Pushes deployments + policies; mirrors status", "API")
Rel_D(karmada, edge_api, "Propagates WorkloadDeployment", "API")

' Edge operators around the edge API server
Rel_R(wdc, edge_api, "WorkloadDeployment → Instances", "reconcile")
Rel_L(co, edge_api, "Instance → VPCAttachment", "reconcile")
Rel_D(co, platform, "Allocates IP", "AddressClaim")
Rel_R(up, edge_api, "Instance → Pod; status sync", "reconcile")
Rel_L(go_op, edge_api, "VPCAttachment → NAD; annotates Pod", "webhook")

' Host data plane
Rel_U(kraftlet, edge_api, "Scheduled Pods; Pod status", "watch")
Rel_L(kraftlet, registry, "Pulls unikernel image", "OCI")
Rel_R(kraftlet, gnet, "Instance networking", "CNI ADD/DEL")
Rel_D(kraftlet, uk, "Boots and supervises", "VMM")
Rel_U(gnet, platform, "Confirms IP allocation", "IPAM CNI")
Rel_R(gnet, fabric, "Announces SRv6 endpoint", "BGP")
Rel_R(uk, fabric, "VPC traffic", "TAP / SRv6")

SHOW_LEGEND()
@enduml
