@startuml component-view
!$NEW_C4_STYLE = 1
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
!include https://raw.githubusercontent.com/datum-cloud/enhancements/main/enhancements/datum-theme.puml

LAYOUT_LEFT_RIGHT()

System_Boundary(node, "Compute Node") {
    Container_Ext(runtime, "Unikraft Runtime", "vendor daemon", "Boots and manages microVMs on this node; reports each instance's lifecycle")
    Container(metering, "Metering Component", "per-node service", "Watches instance lifecycle, attributes each instance to a project (via the instance's identity on the node), and measures actual running time")
    ContainerDb(record, "Local Usage Record", "on-node record", "Attributed, windowed usage — the raw material the shipping step reads")
    Container_Ext(shipping, "Usage Shipping (Vector)", "per-node agent", "Tails the local usage record and forwards each window as a billing Cloudevent")
}

System_Ext(platform, "Datum Platform", "Knows which project owns which instance")
System_Ext(billing, "Platform Billing Pipeline", "Receives billing Cloudevents")

Rel(runtime, metering, "Instance lifecycle", "planned: file log sink (today: Unix socket)")
Rel(platform, metering, "Project / instance identity")
Rel(metering, record, "Writes")
Rel(shipping, record, "Tails")
Rel(shipping, billing, "Forwards usage Cloudevents")

SHOW_LEGEND()
@enduml
