# Make staging available, but never automatic.
#
# Staging version numbers sort above stable, because apt compares 0.12.0-61
# against 0.12.0-5 before it ever reaches the staging or stable suffix. Without
# this file, apt would prefer staging for every package the feed carries.
Package: *
Pin: release c=staging
Pin-Priority: 100

# The agent and platform are the two components we take from staging.
#
# Each one ships under two package names: ukp-agent depends on ukp12-agent, and
# both install the same files. Take only one of a pair from staging and dpkg
# fails when the two try to write the same file, so both names are listed here.
# Keep this list in step with the staging versions pinned in the Dockerfile.
Package: ukp-agent ukp12-agent ukp-platform ukp12-platform
Pin: release c=staging
Pin-Priority: 990
