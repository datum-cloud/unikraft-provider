# Make staging available, but never automatic.
#
# Staging version numbers sort above stable, because apt compares 0.12.0-61
# against 0.12.0-5 before it ever reaches the staging or stable suffix. Without
# this file, apt would prefer staging for every package the feed carries.
#
# Priority 100 keeps stable the default. The exact versions named in the
# Dockerfile still install from staging.
Package: *
Pin: release c=staging
Pin-Priority: 100
